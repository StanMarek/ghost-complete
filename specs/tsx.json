{
  "args": {
    "generators": [
      {
        "requires_js": true
      }
    ],
    "name": "script path"
  },
  "description": "Run TypeScript file using tsx",
  "name": "tsx",
  "options": [
    {
      "description": "Show help for tsx",
      "name": [
        "--help",
        "-h"
      ]
    },
    {
      "description": "Disable caching",
      "name": [
        "--no-cache"
      ]
    },
    {
      "args": {
        "generators": [
          {
            "requires_js": true
          }
        ],
        "name": "script path"
      },
      "description": "Disable clearing the screen on rerun",
      "name": [
        "--clear-screen"
      ]
    },
    {
      "description": "Show version",
      "name": [
        "-v",
        "--version"
      ]
    },
    {
      "args": {
        "generators": [
          {
            "requires_js": true
          }
        ],
        "name": "tsconfig.json path"
      },
      "description": "Custom tsconfig.json path",
      "name": [
        "--tsconfig"
      ]
    }
  ],
  "subcommands": [
    {
      "args": {
        "generators": [
          {
            "requires_js": true
          }
        ],
        "name": "script path"
      },
      "description": "Run the script and watch for changes",
      "name": "watch"
    }
  ]
}
