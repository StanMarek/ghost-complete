{
  "args": {
    "generators": [
      {
        "requires_js": true
      }
    ],
    "isOptional": true,
    "isVariadic": true,
    "name": "source|dir"
  },
  "description": "Render markdown on the CLI, with pizzazz!",
  "name": "glow",
  "options": [
    {
      "description": "Show system files and directories (TUI-mode only)",
      "name": [
        "-a",
        "--all"
      ]
    },
    {
      "args": {
        "name": "path",
        "template": "filepaths"
      },
      "description": "Config file",
      "name": [
        "--config"
      ]
    },
    {
      "description": "Help for glow",
      "name": [
        "-h",
        "--help"
      ]
    },
    {
      "description": "Show local files only; no network (TUI-mode only)",
      "name": [
        "-l",
        "--local"
      ]
    },
    {
      "description": "Display with pager",
      "name": [
        "-p",
        "--pager"
      ]
    },
    {
      "args": {
        "name": "name",
        "suggestions": [
          {
            "name": "auto"
          },
          {
            "name": "light"
          },
          {
            "name": "dark"
          },
          {
            "name": "notty"
          }
        ],
        "template": "filepaths"
      },
      "description": "Style name or JSON path (default 'auto')",
      "name": [
        "-s",
        "--style"
      ]
    },
    {
      "description": "Version for glow",
      "name": [
        "-v",
        "--version"
      ]
    },
    {
      "args": {
        "name": "column"
      },
      "description": "Word-wrap at width",
      "name": [
        "-w",
        "--width"
      ]
    }
  ],
  "subcommands": [
    {
      "description": "Edit the glow config file",
      "name": "config"
    },
    {
      "args": {
        "isOptional": true,
        "name": "command",
        "template": "help"
      },
      "description": "Help about any command",
      "name": "help"
    },
    {
      "args": {
        "generators": [
          {
            "requires_js": true
          }
        ],
        "isOptional": true,
        "name": "path"
      },
      "description": "Manage your stash of markdown files",
      "name": "stash",
      "options": [
        {
          "args": {
            "name": "note"
          },
          "description": "Memo/note for stashing",
          "name": [
            "-m",
            "--memo"
          ]
        }
      ]
    }
  ]
}
